{
	"name": "ft-transcendence",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:server": "tsx watch server/index.cts",
		"dev:all": "concurrently \"pnpm run dev\" \"pnpm run dev:server\"",
		"build": "vite build",
		"build:server": "tsc --project tsconfig.server.json",
		"start": "node build-server/server/index.cjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"generate": "svelte-kit sync && pnpm run db:generate && pnpm exec paraglide-js compile --project ./.inlang --outdir ./src/lib/paraglide",
		"lint:prettier": "prettier --check .",
		"lint:eslint": "eslint .",
		"lint:prisma": "prisma format --check",
		"lint": "pnpm run generate && pnpm run lint:prettier && pnpm run lint:eslint && pnpm run lint:prisma",
		"format": "prettier --write . && prisma format",
		"typecheck": "pnpm run generate && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"typecheck:watch": "pnpm run generate && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "prisma db push",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate",
		"db:studio": "prisma studio"
	},
	"devDependencies": {
		"@better-auth/prisma-adapter": "^1.6.11",
		"@colyseus/schema": "^2.0.37",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@inlang/paraglide-js": "^2.15.2",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.12.0",
		"@prisma/adapter-better-sqlite3": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"@types/express": "^5.0.6",
		"@types/node": "^24",
		"better-auth": "^1.6.11",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"colyseus": "^0.15.57",
		"colyseus.js": "^0.15.28",
		"concurrently": "^9.2.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"express": "^4.21.2",
		"formsnap": "^2.0.1",
		"globals": "^17.4.0",
		"mode-watcher": "^1.1.0",
		"phaser": "^4.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "^7.8.0",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@10.33.0"
}
