{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "build-server",
		"rootDir": ".",
		"declaration": true,
		"emitDeclarationOnly": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"strict": true,
		"sourceMap": true
	},
	"include": ["colyseus/**/*", "src/lib/game/shared/**/*", "src/lib/game/colyseus/**/*"]
}
